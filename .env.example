# Copy to .env (never commit .env). Real environment variables take precedence.

# Provider used for web search and page extraction: "parallel" or "composio".
# Default: "parallel" when PARALLEL_API_KEY is set, otherwise "composio".
FOODSOURCING_PROVIDER=

# Get a key at https://platform.parallel.ai
PARALLEL_API_KEY=

# Only for the optional Composio provider (uses your logged-in `composio` CLI and a linked
# "parallel" toolkit account; no key is read from this file).
# COMPOSIO_BIN=composio
